; Engine configuration file.
; Manaconda's Minigame Mayhem — Godot Spike
config_version=5

[application]

config/name="Manaconda's Minigame Mayhem — Godot Spike"
run/main_scene="res://scenes/shell/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

App="*res://shared/app.gd"

